  approvedDepartments      Department[]           @relation("DepartmentApprover")

  @@index([subsidiaryId])
  @@index([departmentId])
  @@index([locationId])
  @@index([managerId])
  @@index([approverEmployeeId])
  @@index([expenseApproverEmployeeId])
  @@map("employees")
}

model EmployeeSubsidiary {
  id           String   @id @default(cuid())
  employeeId   String
  subsidiaryId String
  createdAt    DateTime @default(now())

  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  subsidiary Subsidiary @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)

  @@unique([employeeId, subsidiaryId])
  @@index([employeeId])
  @@index([subsidiaryId])
  @@map("employee_subsidiaries")
}

model Fulfillment {
  id           String   @id @default(cuid())
  number       String   @unique
  status       String   @default("pending")
  date         DateTime @default(now())
  notes        String?
  subsidiaryId String
  currencyId   String
  salesOrderId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  salesOrder SalesOrder?       @relation(fields: [salesOrderId], references: [id])
  subsidiary Subsidiary            @relation(fields: [subsidiaryId], references: [id])
  currency   Currency              @relation(fields: [currencyId], references: [id])
  lines      FulfillmentLine[]

  @@map("fulfillments")
}

model FulfillmentLine {
  id                   String  @id @default(cuid())
  quantity             Int     @default(1)
  notes                String?
  fulfillmentId        String
  salesOrderLineItemId String?

  fulfillment        Fulfillment         @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  salesOrderLineItem SalesOrderLineItem? @relation(fields: [salesOrderLineItemId], references: [id])

  @@map("fulfillment_lines")
}

model BillPayment {
  id        String   @id @default(cuid())
  number    String   @unique
  amount    Decimal  @default(0) @db.Decimal(18, 2)
  date      DateTime @default(now())
  method    String?
  reference String?
  status    String   @default("pending")
  notes     String?
  vendorId  String?
  billId    String?
  bankAccountId String?
  subsidiaryId String
  currencyId String
  fxRateType String?
  fxRateSource String?
  fxEffectiveDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor Vendor? @relation(fields: [vendorId], references: [id])
  bill Bill? @relation(fields: [billId], references: [id])
  bankAccount ChartOfAccounts? @relation("BillPaymentBankAccount", fields: [bankAccountId], references: [id])
  subsidiary Subsidiary @relation(fields: [subsidiaryId], references: [id])
  currency Currency @relation(fields: [currencyId], references: [id])
  applications BillPaymentApplication[]
  vendorRefunds VendorRefund[]
  bankChecks    BankCheck[]
  paymentRunLines PaymentRunLine[]

  @@index([vendorId])
  @@index([billId])
  @@index([bankAccountId])
  @@index([subsidiaryId])
  @@index([currencyId])
  @@map("bill_payments")
}

model BillPaymentApplication {
  id            String      @id @default(cuid())
  billPaymentId String
  billId        String
  appliedAmount Decimal     @default(0) @db.Decimal(18, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  billPayment BillPayment @relation(fields: [billPaymentId], references: [id], onDelete: Cascade)
  bill        Bill        @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billPaymentId])
  @@index([billId])
  @@unique([billPaymentId, billId])
  @@map("bill_payment_applications")
}

model DocumentRelationship {
  id               String   @id @default(cuid())
  sourceRecordType String
  sourceRecordId   String
  targetRecordType String
  targetRecordId   String
  relationshipType String
  autoGenerated    Boolean  @default(false)
  automationSource String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([sourceRecordType, sourceRecordId, targetRecordType, targetRecordId, relationshipType])
  @@index([sourceRecordType, sourceRecordId])
  @@index([targetRecordType, targetRecordId])
  @@index([relationshipType])
  @@map("document_relationships")
}

model ActivityTypeDefinition {
  id                     String   @id @default(cuid())
  code                   String   @unique
  name                   String
  category               String
  status                 String   @default("active")
  description            String?
  defaultRollForwardGroup String?
  isSystemDefined        Boolean  @default(true)
  isOpenItemRelevant     Boolean  @default(false)
  isClearingRelevant     Boolean  @default(false)
  isFxRelevant           Boolean  @default(false)
  isIntercompanyRelevant Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@map("activity_type_definitions")
}

model RunHeader {
  id               String   @id @default(cuid())
  runNumber        String   @unique
  runType          String
  status           String   @default("queued")
  triggerType      String   @default("manual")
  scopeType        String?
  scopeJson        String?
  requestedAt      DateTime @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  asOfDate         DateTime?
  accountingPeriodId String?
  subsidiaryScope  String?
  message          String?
  summaryJson      String?
  requestedById    String?
  startedById      String?
  completedById    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  accountingPeriod AccountingPeriod? @relation(fields: [accountingPeriodId], references: [id])
  items            RunItem[]
  outputLinks      RunOutputLink[]
  exceptions       RunException[]

  @@index([runType])
  @@index([status])
  @@index([accountingPeriodId])
  @@index([requestedAt])
  @@map("run_headers")
}

model RunItem {
  id               String   @id @default(cuid())
  runHeaderId      String
  itemNumber       Int
  itemType         String
  status           String   @default("pending")
  sourceRecordType String?
  sourceRecordId   String?
  sourceLineId     String?
  targetRecordType String?
  targetRecordId   String?
  targetLineId     String?
  message          String?
  requestPayloadJson String?
  resultPayloadJson String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  runHeader        RunHeader       @relation(fields: [runHeaderId], references: [id], onDelete: Cascade)
  outputLinks      RunOutputLink[]
  exceptions       RunException[]

  @@unique([runHeaderId, itemNumber])
  @@index([status])
  @@index([sourceRecordType, sourceRecordId])
  @@map("run_items")
}

model RunOutputLink {
  id               String   @id @default(cuid())
  runHeaderId      String
  runItemId        String?
  outputType       String
  outputRecordType String?
  outputRecordId   String?
  outputLineId     String?
  glHeaderId       String?
  glLineId         String?
  createdAt        DateTime @default(now())

  runHeader        RunHeader @relation(fields: [runHeaderId], references: [id], onDelete: Cascade)
  runItem          RunItem?  @relation(fields: [runItemId], references: [id], onDelete: SetNull)

  @@index([runItemId])
  @@index([outputRecordType, outputRecordId])
  @@index([glHeaderId])
  @@map("run_output_links")
}

model RunException {
  id               String   @id @default(cuid())
  runHeaderId      String
  runItemId        String?
  severity         String
  exceptionType    String
  status           String   @default("open")
  sourceRecordType String?
  sourceRecordId   String?
  message          String
  detailsJson      String?
  assignedToId     String?
  resolvedAt       DateTime?
  resolvedById     String?
  resolutionNote   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  runHeader        RunHeader @relation(fields: [runHeaderId], references: [id], onDelete: Cascade)
  runItem          RunItem?  @relation(fields: [runItemId], references: [id], onDelete: SetNull)

  @@index([runItemId])
  @@index([status])
  @@index([assignedToId])
  @@index([sourceRecordType, sourceRecordId])
  @@map("run_exceptions")
}

model OpenItem {
  id                       String   @id @default(cuid())
  openItemNumber           String   @unique
  openItemType             String
  status                   String
  accountType              String
  accountId                String?
  subsidiaryId             String
  transactionCurrencyId    String
  localCurrencyId          String?
  functionalCurrencyId     String?
  groupCurrencyId          String?
  sourceTransactionType    String?
  sourceTransactionId      String?
  sourceTransactionLineId  String?
  sourceNumber             String?
  counterpartyType         String?
  counterpartyId           String?
  documentDate             DateTime?
  postingDate              DateTime?
  dueDate                  DateTime?
  originalTransactionAmount Decimal @db.Decimal(18, 2)
  originalLocalAmount      Decimal? @db.Decimal(18, 2)
  originalFunctionalAmount Decimal? @db.Decimal(18, 2)
  originalGroupAmount      Decimal? @db.Decimal(18, 2)
  openItemEligible         Boolean  @default(true)
  isOpen                   Boolean  @default(true)
  closedAt                 DateTime?
  closedById               String?
  memo                     String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  account                  ChartOfAccounts? @relation(fields: [accountId], references: [id])
  entries                  OpenItemEntry[]
  applicationsFrom         OpenItemApplication[] @relation("OpenItemApplicationFrom")
  applicationsTo           OpenItemApplication[] @relation("OpenItemApplicationTo")
  clearingLinesFrom        ClearingDocumentLine[] @relation("ClearingLineFromOpenItem")
  clearingLinesTo          ClearingDocumentLine[] @relation("ClearingLineToOpenItem")

  @@index([status])
  @@index([isOpen])
  @@index([openItemType])
  @@index([accountId])
  @@index([subsidiaryId])
  @@index([sourceTransactionType, sourceTransactionId])
  @@index([counterpartyType, counterpartyId])
  @@index([accountId, isOpen])
  @@index([accountId, subsidiaryId, isOpen])
  @@index([subsidiaryId, isOpen, postingDate])
  @@index([counterpartyType, counterpartyId, isOpen])
  @@index([groupCurrencyId])
  @@map("open_items")
}

model OpenItemEntry {
  id                    String   @id @default(cuid())
  openItemId            String
  entryNumber           Int
  entryType             String
  effectiveDate         DateTime
  postingDate           DateTime?
  accountingPeriodId    String?
  transactionAmount     Decimal  @db.Decimal(18, 2)
  localAmount           Decimal? @db.Decimal(18, 2)
  functionalAmount      Decimal? @db.Decimal(18, 2)
  groupAmount           Decimal? @db.Decimal(18, 2)
  sourceTransactionType String?
  sourceTransactionId   String?
  sourceTransactionLineId String?
  sourceApplicationId   String?
  sourceGlLineId        String?
  sourceRunId           String?
  memo                  String?
  createdAt             DateTime @default(now())
  createdById           String?

  openItem              OpenItem          @relation(fields: [openItemId], references: [id], onDelete: Cascade)
  accountingPeriod      AccountingPeriod? @relation(fields: [accountingPeriodId], references: [id])

  @@unique([openItemId, entryNumber])
  @@index([entryType])
  @@index([postingDate])
  @@index([sourceApplicationId])
  @@index([sourceTransactionType, sourceTransactionId])
  @@index([sourceGlLineId])
  @@index([openItemId, effectiveDate])
  @@map("open_item_entries")
}

model OpenItemApplication {
  id                    String   @id @default(cuid())
  applicationNumber     String   @unique
  applicationType       String
  status                String
  fromOpenItemId        String
  toOpenItemId          String?
  settlementTransactionType String?
  settlementTransactionId String?
  applicationDate       DateTime
  postingDate           DateTime?
  transactionAmount     Decimal  @db.Decimal(18, 2)
  localAmount           Decimal? @db.Decimal(18, 2)
  functionalAmount      Decimal? @db.Decimal(18, 2)
  groupAmount           Decimal? @db.Decimal(18, 2)
  realizedFxLocalAmount Decimal? @db.Decimal(18, 2)
  realizedFxFunctionalAmount Decimal? @db.Decimal(18, 2)
  realizedFxGroupAmount Decimal? @db.Decimal(18, 2)
  exchangeRateContextId String?
  reversesApplicationId String?
  memo                  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  createdById           String?

  fromOpenItem          OpenItem           @relation("OpenItemApplicationFrom", fields: [fromOpenItemId], references: [id], onDelete: Cascade)
  toOpenItem            OpenItem?          @relation("OpenItemApplicationTo", fields: [toOpenItemId], references: [id], onDelete: SetNull)
  clearingLines         ClearingDocumentLine[]

  @@index([fromOpenItemId])
  @@index([toOpenItemId])
  @@index([applicationDate])
  @@index([postingDate])
  @@index([settlementTransactionType, settlementTransactionId])
  @@index([reversesApplicationId])
  @@index([fromOpenItemId, applicationDate])
  @@index([toOpenItemId, applicationDate])
  @@map("open_item_applications")
}

model ClearingDocumentHeader {
  id                       String   @id @default(cuid())
  clearingNumber           String   @unique
  clearingType             String
  status                   String
  subsidiaryId             String
  transactionCurrencyId    String
  localCurrencyId          String?
  functionalCurrencyId     String?
  groupCurrencyId          String?
  clearingDate             DateTime
  postingDate              DateTime?
  accountingPeriodId       String?
  sourceTransactionType    String?
  sourceTransactionId      String?
  sourceRunId              String?
  counterpartyType         String?
  counterpartyId           String?
  transactionAmount        Decimal  @db.Decimal(18, 2)
  localAmount              Decimal? @db.Decimal(18, 2)
  functionalAmount         Decimal? @db.Decimal(18, 2)
  groupAmount              Decimal? @db.Decimal(18, 2)
  realizedFxLocalAmount    Decimal? @db.Decimal(18, 2)
  realizedFxFunctionalAmount Decimal? @db.Decimal(18, 2)
  realizedFxGroupAmount    Decimal? @db.Decimal(18, 2)
  memo                     String?
  reversesClearingDocumentId String?
  reversedByClearingDocumentId String?
  autoGenerated            Boolean  @default(false)
  automationSource         String?
  exceptionStatus          String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  createdById              String?
  postedById               String?
  reversedById             String?

  accountingPeriod         AccountingPeriod?     @relation(fields: [accountingPeriodId], references: [id])
  lines                    ClearingDocumentLine[]

  @@index([status])
  @@index([clearingType])
  @@index([clearingDate])
  @@index([sourceTransactionType, sourceTransactionId])
  @@index([sourceRunId])
  @@index([counterpartyType, counterpartyId])
  @@index([autoGenerated])
  @@index([exceptionStatus])
  @@map("clearing_document_headers")
}

model ClearingDocumentLine {
  id                         String   @id @default(cuid())
  clearingDocumentId         String
  lineNumber                 Int
  lineRole                   String
  fromOpenItemId             String?
  toOpenItemId               String?
  sourceTransactionType      String?
  sourceTransactionId        String?
  sourceTransactionLineId    String?
  settlementTransactionType  String?
  settlementTransactionId    String?
  settlementTransactionLineId String?
  originalExchangeRateContextId String?
  settlementExchangeRateContextId String?
  transactionAmount          Decimal  @db.Decimal(18, 2)
  localAmount                Decimal? @db.Decimal(18, 2)
  functionalAmount           Decimal? @db.Decimal(18, 2)
  groupAmount                Decimal? @db.Decimal(18, 2)
  realizedFxLocalAmount      Decimal? @db.Decimal(18, 2)
  realizedFxFunctionalAmount Decimal? @db.Decimal(18, 2)
  realizedFxGroupAmount      Decimal? @db.Decimal(18, 2)
  openItemApplicationId      String?
  sourceGlLineId             String?
  settlementGlLineId         String?
  memo                       String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  clearingDocument           ClearingDocumentHeader @relation(fields: [clearingDocumentId], references: [id], onDelete: Cascade)
  fromOpenItem               OpenItem?              @relation("ClearingLineFromOpenItem", fields: [fromOpenItemId], references: [id], onDelete: SetNull)
  toOpenItem                 OpenItem?              @relation("ClearingLineToOpenItem", fields: [toOpenItemId], references: [id], onDelete: SetNull)
  openItemApplication        OpenItemApplication?   @relation(fields: [openItemApplicationId], references: [id], onDelete: SetNull)

  @@unique([clearingDocumentId, lineNumber])
  @@index([fromOpenItemId])
  @@index([toOpenItemId])
  @@index([openItemApplicationId])
  @@index([sourceTransactionType, sourceTransactionId])
  @@index([settlementTransactionType, settlementTransactionId])
  @@index([sourceGlLineId])
  @@index([settlementGlLineId])
  @@map("clearing_document_lines")
}
