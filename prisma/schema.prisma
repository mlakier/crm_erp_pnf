  nciEquityAccount            ChartOfAccounts?           @relation("SubsidiaryNciEquityAccount", fields: [nciEquityAccountId], references: [id])
  nciIncomeStatementAccount   ChartOfAccounts?           @relation("SubsidiaryNciIncomeStatementAccount", fields: [nciIncomeStatementAccountId], references: [id])
  realizedFxGainAccount       ChartOfAccounts?           @relation("SubsidiaryRealizedFxGainAccount", fields: [realizedFxGainAccountId], references: [id])
  realizedFxLossAccount       ChartOfAccounts?           @relation("SubsidiaryRealizedFxLossAccount", fields: [realizedFxLossAccountId], references: [id])
  unrealizedFxGainAccount     ChartOfAccounts?           @relation("SubsidiaryUnrealizedFxGainAccount", fields: [unrealizedFxGainAccountId], references: [id])
  unrealizedFxLossAccount     ChartOfAccounts?           @relation("SubsidiaryUnrealizedFxLossAccount", fields: [unrealizedFxLossAccountId], references: [id])
  departmentAssignments       DepartmentSubsidiary[]
  itemAssignments             ItemSubsidiary[]
  employeeAssignments         EmployeeSubsidiary[]
  userAssignments             UserSubsidiary[]
  defaultForUsers             User[]                    @relation("UserDefaultSubsidiary")
  locations                   Location[]                 @relation("LocationSubsidiary")
  employees                   Employee[]
  items                       Item[]
  customers                   Customer[]
  customerEntitySettings      CustomerEntitySetting[] @relation("CustomerEntitySettingSubsidiary")
  customerEntityIntercompanyPartners CustomerEntitySetting[] @relation("CustomerEntitySettingIntercompanyPartner")
  customerTaxProfiles         CustomerTaxProfile[] @relation("CustomerTaxProfileSubsidiary")
  customerCreditProfiles      CustomerCreditProfile[] @relation("CustomerCreditProfileSubsidiary")
  customerDimensionDefaults   CustomerDimensionDefault[] @relation("CustomerDimensionDefaultSubsidiary")
  priceLevels                 PriceLevel[]
  priceBooks                  PriceBook[]
  billingAccounts             BillingAccount[]
  subscriptionPlans           SubscriptionPlan[]
  vendors                     Vendor[]
  leads                       Lead[]
  opportunities               Opportunity[]
  quotes                      Quote[]
  salesOrders                 SalesOrder[]
  invoices                    Invoice[]
  cashReceipts                CashReceipt[]
  creditMemos                 CreditMemo[]
  customerRefunds             CustomerRefund[]
  vendorRefunds               VendorRefund[]
  purchaseOrders              PurchaseOrder[]
  receipts                    Receipt[]
  bills                       Bill[]
  billCredits                 BillCredit[]
  billPayments                BillPayment[]
  requisitions                Requisition[]
  journalEntries              JournalEntry[]
  journalEntryLineItems       JournalEntryLineItem[]
  accountingPeriods           AccountingPeriod[]
  chartOfAccountsAsParent     ChartOfAccounts[]          @relation("ChartOfAccountParentSubsidiary")
  chartOfAccountAssignments   ChartOfAccountSubsidiary[] @relation("ChartOfAccountSubsidiaryAssignment")
  fulfillments                Fulfillment[]
  bankAccounts                BankAccount[]              @relation("BankAccountSubsidiary")
  bankDeposits                BankDeposit[]              @relation("BankDepositSubsidiary")
  bankTransfers               BankTransfer[]             @relation("BankTransferSubsidiary")
  bankChecks                  BankCheck[]                @relation("BankCheckSubsidiary")
  paymentRuns                 PaymentRun[]               @relation("PaymentRunSubsidiary")
  bankReconciliations         BankReconciliation[]       @relation("BankReconciliationSubsidiary")

