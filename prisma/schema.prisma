// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

model ListOption {
  id        String   @id @default(cuid())
  key       String // e.g. CUST-INDUSTRY
  listId    String // e.g. LIST-CUST-INDUSTRY-0001
  value     String // e.g. Quick Service Restaurant
  label     String // e.g. Quick Service Restaurant
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listId])
  @@index([key, sortOrder])
  @@map("list_options")
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String      @id @default(cuid())
  userId                  String?     @unique
  email                   String      @unique
  name                    String?
  password                String
  roleId                  String?     @map("role_id")
  role                    Role?       @relation(fields: [roleId], references: [id])
  departmentId            String?
  department              Department? @relation(fields: [departmentId], references: [id])
  inactive                Boolean     @default(false)
  locked                  Boolean     @default(false)
  lockedAt                DateTime?
  lastLoginAt             DateTime?
  passwordChangedAt       DateTime?
  mustChangePassword      Boolean     @default(false)
  failedLoginAttempts     Int         @default(0)
  defaultSubsidiaryId     String?
  defaultSubsidiary       Subsidiary?     @relation("UserDefaultSubsidiary", fields: [defaultSubsidiaryId], references: [id], onDelete: SetNull)
  includeChildren         Boolean     @default(false)
  approvalLimit           Decimal?  @db.Decimal(18, 2)
  approvalCurrencyId      String?
  approvalCurrency        Currency?   @relation("UserApprovalCurrency", fields: [approvalCurrencyId], references: [id], onDelete: SetNull)
  delegatedApproverUserId String?
  delegatedApprover       User?       @relation("UserDelegatedApprover", fields: [delegatedApproverUserId], references: [id], onDelete: SetNull)
  delegatedApproverFor    User[]      @relation("UserDelegatedApprover")
  delegationStartDate     DateTime?
  delegationEndDate       DateTime?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  // Relations
  subsidiaryAssignments UserSubsidiary[]
  customers             Customer[]
  contacts              Contact[]
  customerCreditProfilesOwned CustomerCreditProfile[] @relation("CustomerCreditProfileCollectionsOwner")
  customerAuditLogs     CustomerAuditLog[] @relation("CustomerAuditLogActor")
  projects              Project[]
  tasks                 Task[]
  leads                 Lead[]
  opportunities         Opportunity[]
  quotes                Quote[]
  salesOrders           SalesOrder[]
  invoices              Invoice[]
  customerRefunds       CustomerRefund[]
  vendorRefunds         VendorRefund[]
  requisitions          Requisition[]
  purchaseOrders        PurchaseOrder[]
  creditMemos           CreditMemo[]
  billCredits           BillCredit[]
  bills                 Bill[]
  journalEntries        JournalEntry[]
  employee              Employee?
  savedListViews        SavedListView[]

  @@index([roleId])
  @@index([departmentId])
  @@index([defaultSubsidiaryId])
  @@index([approvalCurrencyId])
  @@index([delegatedApproverUserId])
  @@map("users")
}

model UserSubsidiary {
  id           String   @id @default(cuid())
  userId       String
  subsidiaryId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subsidiary Subsidiary @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)

  @@unique([userId, subsidiaryId])
  @@index([userId])
  @@index([subsidiaryId])
  @@map("user_subsidiaries")
}

model SavedListView {
  id          String   @id @default(cuid())
  userId      String
  tableId     String
  name        String
  columnIds   String
  columnOrder String
  filterState String   @default("{}")
  availableFilterIds String @default("[]")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tableId, name])
  @@index([userId, tableId])
  @@index([userId, tableId, isDefault])
  @@map("saved_list_views")
}

model Customer {
  id         String   @id @default(cuid())
  customerId String?  @unique
  // Add locale here when customer-facing document formatting expands beyond company-level defaults.
  name       String
  email      String?
  phone      String?
  address    String?
  industry   String?
  customerType String?
  customerGroup String?
  customerStatus String?
  territory String?
  salesManager String?
  projectManager String?
  arAccountId String?
  startDate DateTime?
  endDate DateTime?
  reminderDays Int?
  priceLevel String?
  priceBook String?
  taxable Boolean @default(false)
  taxItem String?
  resaleNumber String?
  language String?
  numberFormat String?
  negativeNumberFormat String?
  shipComplete Boolean @default(false)
  shippingCarrier String?
  shippingMethod String?
  blockCollectionEmail Boolean @default(false)
  collectionsRep String?
  subsidiaryId String?
  currencyId String?
  includeChildren Boolean @default(false)
  inactive   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  userId                String
  user                  User                   @relation(fields: [userId], references: [id])
  contacts              Contact[]
  entitySettings        CustomerEntitySetting[]
  addresses             CustomerAddress[]
  taxProfiles           CustomerTaxProfile[]
  creditProfiles        CustomerCreditProfile[]
  dimensionDefaults     CustomerDimensionDefault[]
  contracts             CustomerContract[]
  auditLogs             CustomerAuditLog[]
  billingAccounts       BillingAccount[]
  leads                 Lead[]
  opportunities         Opportunity[]
  quotes                Quote[]
  salesOrders           SalesOrder[]
  invoices              Invoice[]
  creditMemos           CreditMemo[]
  customerRefunds       CustomerRefund[]
  journalEntryLineItems JournalEntryLineItem[]
  subsidiary            Subsidiary?            @relation(fields: [subsidiaryId], references: [id])
  currency              Currency?              @relation(fields: [currencyId], references: [id])
  arAccount             ChartOfAccounts?       @relation("CustomerArAccount", fields: [arAccountId], references: [id])
  paymentInstruments    CustomerPaymentInstrument[]

  @@index([userId])
  @@index([subsidiaryId])
  @@index([currencyId])
  @@index([arAccountId])
  @@index([customerType])
  @@index([customerGroup])
  @@index([customerStatus])
  @@map("customers")
}

model CustomerEntitySetting {
  id                              String   @id @default(cuid())
  customerId                      String
  subsidiaryId                    String?
  isEnabledForEntity              Boolean  @default(true)
  defaultArAccountId              String?
  defaultRevenueAccountId         String?
  defaultDeferredRevenueAccountId String?
  defaultUnbilledArAccountId      String?
  paymentTerms                    String?
  defaultDueDays                  Int?
  currencyId                      String?
  taxCode                         String?
  creditLimit                     Decimal? @db.Decimal(18, 2)
  billingHold                     Boolean  @default(false)
  billingHoldReason               String?
  invoiceDeliveryMethod           String?
  intercompanyPartnerSubsidiaryId String?
  inactive                        Boolean  @default(false)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  customer                      Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subsidiary                    Subsidiary?      @relation("CustomerEntitySettingSubsidiary", fields: [subsidiaryId], references: [id])
  currency                      Currency?        @relation("CustomerEntitySettingCurrency", fields: [currencyId], references: [id])
  defaultArAccount              ChartOfAccounts? @relation("CustomerEntitySettingArAccount", fields: [defaultArAccountId], references: [id])
  defaultRevenueAccount         ChartOfAccounts? @relation("CustomerEntitySettingRevenueAccount", fields: [defaultRevenueAccountId], references: [id])
  defaultDeferredRevenueAccount ChartOfAccounts? @relation("CustomerEntitySettingDeferredRevenueAccount", fields: [defaultDeferredRevenueAccountId], references: [id])
  defaultUnbilledArAccount      ChartOfAccounts? @relation("CustomerEntitySettingUnbilledArAccount", fields: [defaultUnbilledArAccountId], references: [id])
  intercompanyPartnerSubsidiary Subsidiary?      @relation("CustomerEntitySettingIntercompanyPartner", fields: [intercompanyPartnerSubsidiaryId], references: [id])

  @@unique([customerId, subsidiaryId])
  @@index([customerId])
  @@index([subsidiaryId])
  @@index([currencyId])
  @@index([defaultArAccountId])
  @@index([defaultRevenueAccountId])
  @@index([defaultDeferredRevenueAccountId])
  @@index([defaultUnbilledArAccountId])
  @@index([intercompanyPartnerSubsidiaryId])
  @@map("customer_entity_settings")
}

model CustomerAddress {
  id                String   @id @default(cuid())
  customerId        String
  addressId         String?  @unique
  addressType       String   @default("billing")
  attentionTo       String?
  line1             String?
  line2             String?
  city              String?
  stateRegion       String?
  postalCode        String?
  countryCode       String?
  taxJurisdictionId String?
  isPrimary         Boolean  @default(false)
  isActive          Boolean  @default(true)
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([addressType])
  @@index([countryCode])
  @@map("customer_addresses")
}

model CustomerTaxProfile {
  id                         String    @id @default(cuid())
  customerId                 String
  taxProfileId               String?   @unique
  subsidiaryId               String?
  taxCountry                 String?
  taxRegistrationNumber      String?
  taxExempt                  Boolean   @default(false)
  taxExemptionCertificateId  String?
  taxExemptionExpirationDate DateTime?
  resaleCertificateNumber    String?
  vatReverseChargeApplicable Boolean   @default(false)
  taxCode                    String?
  taxEngineCustomerCode      String?
  taxValidationStatus        String?
  validatedAt                DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subsidiary Subsidiary? @relation("CustomerTaxProfileSubsidiary", fields: [subsidiaryId], references: [id])

  @@index([customerId])
  @@index([subsidiaryId])
  @@index([taxCountry])
  @@index([taxCode])
  @@map("customer_tax_profiles")
}

model CustomerCreditProfile {
  id                     String    @id @default(cuid())
  customerId             String
  creditProfileId        String?   @unique
  subsidiaryId           String?
  creditLimit            Decimal?  @db.Decimal(18, 2)
  creditCurrencyId       String?
  creditStatus           String    @default("pending_review")
  creditRating           String?
  creditReviewDate       DateTime?
  nextCreditReviewDate   DateTime?
  averageDaysToPay       Decimal?  @db.Decimal(10, 2)
  highestBalance         Decimal?  @db.Decimal(18, 2)
  dunningLevel           String?
  collectionsOwnerUserId String?
  creditHold             Boolean   @default(false)
  creditHoldReason       String?
  collectionsHold        Boolean   @default(false)
  blockCollectionEmail   Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  customer             Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subsidiary           Subsidiary? @relation("CustomerCreditProfileSubsidiary", fields: [subsidiaryId], references: [id])
  creditCurrency       Currency?   @relation("CustomerCreditProfileCurrency", fields: [creditCurrencyId], references: [id])
  collectionsOwnerUser User?       @relation("CustomerCreditProfileCollectionsOwner", fields: [collectionsOwnerUserId], references: [id])

  @@index([customerId])
  @@index([subsidiaryId])
  @@index([creditCurrencyId])
  @@index([collectionsOwnerUserId])
  @@index([creditStatus])
  @@map("customer_credit_profiles")
}

model CustomerDimensionDefault {
  id                    String    @id @default(cuid())
  customerId            String
  subsidiaryId          String?
  dimensionDefinitionId String
  dimensionValueId      String
  effectiveFrom         DateTime?
  effectiveTo           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  customer            Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subsidiary          Subsidiary?          @relation("CustomerDimensionDefaultSubsidiary", fields: [subsidiaryId], references: [id])
  dimensionDefinition DimensionDefinition @relation("CustomerDimensionDefaultDefinition", fields: [dimensionDefinitionId], references: [id], onDelete: Cascade)
  dimensionValue      DimensionValue      @relation("CustomerDimensionDefaultValue", fields: [dimensionValueId], references: [id], onDelete: Cascade)

  @@unique([customerId, subsidiaryId, dimensionDefinitionId, effectiveFrom])
  @@index([customerId])
  @@index([subsidiaryId])
  @@index([dimensionDefinitionId])
  @@index([dimensionValueId])
  @@map("customer_dimension_defaults")
}

model CustomerContract {
  id                   String    @id @default(cuid())
  customerId           String
  contractNumber       String    @unique
  contractStatus       String    @default("draft")
  contractStartDate    DateTime?
  contractEndDate      DateTime?
  autoRenew            Boolean   @default(false)
  renewalTermMonths    Int?
  noticePeriodDays     Int?
  billingTerms         String?
  contractCurrencyId   String?
  signedDocumentId     String?
  description          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contractCurrency Currency? @relation("CustomerContractCurrency", fields: [contractCurrencyId], references: [id])

  @@index([customerId])
  @@index([contractCurrencyId])
  @@index([contractStatus])
  @@map("customer_contracts")
}

model CustomerAuditLog {
  id            String   @id @default(cuid())
  customerId    String
  actorUserId   String?
  action        String
  fieldName     String?
  oldValue      String?
  newValue      String?
  changeReason  String?
  source        String?
  createdAt     DateTime @default(now())

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  actorUser User?    @relation("CustomerAuditLogActor", fields: [actorUserId], references: [id])

  @@index([customerId])
  @@index([actorUserId])
  @@index([action])
  @@map("customer_audit_log")
}

model CustomerPaymentInstrument {
  id                  String   @id @default(cuid())
  customerId          String
  instrumentId        String?  @unique
  paymentType         String   @default("ach")
  status              String   @default("draft")
  bankName            String?
  accountHolderName   String?
  maskedAccountNumber String?
  routingNumberMasked String?
  bankCountry         String?
  currencyId          String?
  accountType         String?
  mandateReference    String?
  mandateStatus       String?
  tokenProvider       String?
  tokenReference      String?
  encryptedPayloadRef String?
  isDefault           Boolean  @default(false)
  inactive            Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  currency Currency? @relation("CustomerPaymentInstrumentCurrency", fields: [currencyId], references: [id])
  billingAccounts BillingAccount[]

  @@index([customerId])
  @@index([currencyId])
  @@index([paymentType])
  @@index([status])
  @@map("customer_payment_instruments")
}

model PriceLevel {
  id                   String   @id @default(cuid())
  priceLevelId         String?  @unique
  name                 String
  description          String?
  levelType            String?
  subsidiaryId         String?
  includeChildren      Boolean  @default(false)
  defaultDiscountPct   Decimal? @db.Decimal(9, 4)
  minimumMarginPct     Decimal? @db.Decimal(9, 4)
  approvalRequired     Boolean  @default(false)
  approvalWorkflow     String?
  allowManualOverride  Boolean  @default(true)
  effectiveStartDate   DateTime?
  effectiveEndDate     DateTime?
  inactive             Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  subsidiary Subsidiary? @relation(fields: [subsidiaryId], references: [id])
  priceBooks PriceBook[]
  billingAccounts BillingAccount[]
  subscriptionPlans SubscriptionPlan[]

  @@index([subsidiaryId])
  @@index([levelType])
  @@index([inactive])
  @@map("price_levels")
}

model PriceBook {
  id                   String   @id @default(cuid())
  priceBookId          String?  @unique
  name                 String
  description          String?
  bookType             String?
  subsidiaryId         String?
  includeChildren      Boolean  @default(false)
  currencyId           String?
  defaultPriceLevelId  String?
  approvalRequired     Boolean  @default(false)
  approvalWorkflow     String?
  allowManualOverride  Boolean  @default(true)
  effectiveStartDate   DateTime?
  effectiveEndDate     DateTime?
  inactive             Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  subsidiary        Subsidiary? @relation(fields: [subsidiaryId], references: [id])
  currency          Currency?   @relation(fields: [currencyId], references: [id])
  defaultPriceLevel PriceLevel? @relation(fields: [defaultPriceLevelId], references: [id])
  priceBookItems    PriceBookItem[]
  billingAccounts   BillingAccount[]
  subscriptionPlans SubscriptionPlan[]

  @@index([subsidiaryId])
  @@index([currencyId])
  @@index([defaultPriceLevelId])
  @@index([bookType])
  @@index([inactive])
  @@map("price_books")
}

model PriceBookItem {
  id                  String   @id @default(cuid())
  priceBookItemId     String?  @unique
  priceBookId         String
  itemId              String
  unitPrice           Decimal  @db.Decimal(19, 4)
  currencyId          String?
  uom                 String?
  minimumQuantity     Decimal? @db.Decimal(18, 4)
  maximumQuantity     Decimal? @db.Decimal(18, 4)
  effectiveStartDate  DateTime?
  effectiveEndDate    DateTime?
  status              String   @default("active")
  priceSource         String   @default("manual")
  marginFloorPct      Decimal? @db.Decimal(9, 4)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  priceBook PriceBook @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id])
  currency  Currency? @relation(fields: [currencyId], references: [id])

  @@index([priceBookId])
  @@index([itemId])
  @@index([currencyId])
  @@index([status])
  @@index([priceSource])
  @@map("price_book_items")
}

model BillingSchedule {
  id                    String   @id @default(cuid())
  billingScheduleId     String?  @unique
  name                  String
  description           String?
  scheduleType          String?
  frequency             String?
  billingTiming         String?
  billingAnchor         String?
  billingDay            Int?
  prorationPolicy       String?
  renewalMode           String?
  invoiceGroupingPolicy String?
  graceDays             Int?
  minimumBillAmount     Decimal? @db.Decimal(18, 2)
  currencyId            String?
  inactive              Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  currency          Currency? @relation(fields: [currencyId], references: [id])
  billingAccounts   BillingAccount[]
  subscriptionPlans SubscriptionPlan[]

  @@index([scheduleType])
  @@index([frequency])
  @@index([currencyId])
  @@index([inactive])
  @@map("billing_schedules")
}

model BillingAccount {
  id                       String   @id @default(cuid())
  billingAccountId         String?  @unique
  name                     String
  description              String?
  customerId               String?
  accountType              String?
  status                   String?  @default("active")
  subsidiaryId             String?
  includeChildren          Boolean  @default(false)
  currencyId               String?
  defaultBillingScheduleId String?
  defaultPriceBookId       String?
  defaultPriceLevelId      String?
  billToContactId          String?
  invoiceDeliveryMethod    String?
  billingEmail             String?
  billingAddress           String?
  paymentTerms             String?
  paymentMethod            String?
  paymentInstrumentId      String?
  consolidateInvoices      Boolean  @default(true)
  requiresPurchaseOrder    Boolean  @default(false)
  poNumber                 String?
  taxable                  Boolean  @default(false)
  taxCode                  String?
  taxRegistrationStatus    String?
  creditHold               Boolean  @default(false)
  collectionsHold          Boolean  @default(false)
  directDebitEnabled       Boolean  @default(false)
  inactive                 Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  customer               Customer?                  @relation(fields: [customerId], references: [id])
  subsidiary             Subsidiary?                @relation(fields: [subsidiaryId], references: [id])
  currency               Currency?                  @relation(fields: [currencyId], references: [id])
  defaultBillingSchedule BillingSchedule?           @relation(fields: [defaultBillingScheduleId], references: [id])
  defaultPriceBook       PriceBook?                 @relation(fields: [defaultPriceBookId], references: [id])
  defaultPriceLevel      PriceLevel?                @relation(fields: [defaultPriceLevelId], references: [id])
  billToContact          Contact?                   @relation(fields: [billToContactId], references: [id])
  paymentInstrument      CustomerPaymentInstrument? @relation(fields: [paymentInstrumentId], references: [id])

  @@index([customerId])
  @@index([accountType])
  @@index([status])
  @@index([subsidiaryId])
  @@index([currencyId])
  @@index([defaultBillingScheduleId])
  @@index([defaultPriceBookId])
  @@index([defaultPriceLevelId])
  @@index([billToContactId])
  @@index([paymentInstrumentId])
  @@index([inactive])
  @@map("billing_accounts")
}

model SubscriptionPlan {
  id                       String   @id @default(cuid())
  subscriptionPlanId       String?  @unique
  name                     String
  description              String?
  planType                 String?
  billingModel             String?
  status                   String?  @default("draft")
  itemId                   String?
  subsidiaryId             String?
  includeChildren          Boolean  @default(false)
  currencyId               String?
  defaultBillingScheduleId String?
  defaultPriceBookId       String?
  defaultPriceLevelId      String?
  termMonths               Int?
  autoRenew                Boolean  @default(false)
  renewalMode              String?
  renewalTermMonths        Int?
  usageRatingModel         String?
  includedQuantity         Decimal? @db.Decimal(18, 4)
  overageRate              Decimal? @db.Decimal(18, 4)
  minimumCommitAmount      Decimal? @db.Decimal(18, 2)
  setupFeeAmount           Decimal? @db.Decimal(18, 2)
  revenueRecognitionPolicy String?
  revenueAccountId         String?
  deferredRevenueAccountId String?
  costAccountId            String?
  deferredCostAccountId    String?
  inactive                 Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  item                   Item?             @relation(fields: [itemId], references: [id])
  subsidiary             Subsidiary?       @relation(fields: [subsidiaryId], references: [id])
  currency               Currency?         @relation(fields: [currencyId], references: [id])
  defaultBillingSchedule BillingSchedule?  @relation(fields: [defaultBillingScheduleId], references: [id])
  defaultPriceBook       PriceBook?        @relation(fields: [defaultPriceBookId], references: [id])
  defaultPriceLevel      PriceLevel?       @relation(fields: [defaultPriceLevelId], references: [id])
  revenueAccount         ChartOfAccounts?  @relation("SubscriptionPlanRevenueAccount", fields: [revenueAccountId], references: [id])
  deferredRevenueAccount ChartOfAccounts?  @relation("SubscriptionPlanDeferredRevenueAccount", fields: [deferredRevenueAccountId], references: [id])
  costAccount            ChartOfAccounts?  @relation("SubscriptionPlanCostAccount", fields: [costAccountId], references: [id])
  deferredCostAccount    ChartOfAccounts?  @relation("SubscriptionPlanDeferredCostAccount", fields: [deferredCostAccountId], references: [id])

  @@index([planType])
  @@index([billingModel])
  @@index([status])
  @@index([itemId])
  @@index([subsidiaryId])
  @@index([currencyId])
  @@index([defaultBillingScheduleId])
  @@index([defaultPriceBookId])
  @@index([defaultPriceLevelId])
  @@index([revenueAccountId])
  @@index([deferredRevenueAccountId])
  @@index([costAccountId])
  @@index([deferredCostAccountId])
  @@index([inactive])
  @@map("subscription_plans")
}

model Contact {
  id                        String   @id @default(cuid())
  contactNumber             String?  @unique
  firstName                 String
  lastName                  String
  email                     String?
  phone                     String?
  mobile                    String?
  address                   String?
  position                  String?
  contactType               String?
  isPrimaryForCustomer      Boolean  @default(false)
  receivesQuotesSalesOrders Boolean  @default(false)
  receivesInvoices          Boolean  @default(false)
  receivesInvoiceCc         Boolean  @default(false)
  receivesStatements        Boolean  @default(false)
  receivesDunning           Boolean  @default(false)
  receivesContractNotices   Boolean  @default(false)
  receivesTaxNotices        Boolean  @default(false)
  receivesSupportNotices    Boolean  @default(false)
  active                    Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  // Relations
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  vendorId   String?
  vendor     Vendor?   @relation(fields: [vendorId], references: [id])
  billingAccounts BillingAccount[]
  leads      Lead[]
  userId     String
  user       User      @relation(fields: [userId], references: [id])

  @@index([customerId])
  @@index([vendorId])
  @@index([userId])
  @@map("contacts")
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  status      String    @default("planning")
  inactive    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  userId                String
  user                  User                   @relation(fields: [userId], references: [id])
