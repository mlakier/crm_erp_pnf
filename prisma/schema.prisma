  @@index([groupCurrencyId])
  @@index([parentSubsidiaryId])
  @@index([eliminationTargetParentId])
  @@index([retainedEarningsAccountId])
  @@index([ctaAccountId])
  @@index([intercompanyClearingAccountId])
  @@index([dueToAccountId])
  @@index([dueFromAccountId])
  @@index([investmentInSubsidiaryAccountId])
  @@index([nciEquityAccountId])
  @@index([nciIncomeStatementAccountId])
  @@index([realizedFxGainAccountId])
  @@index([realizedFxLossAccountId])
  @@index([unrealizedFxGainAccountId])
  @@index([unrealizedFxLossAccountId])
